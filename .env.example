# Copy to .env and fill in real values. Never commit .env.

# HIS = HOSxP on MySQL (hospital production DB, READ-ONLY). Use a DB user that has SELECT grants only.
HIS_HOST=
HIS_PORT=
HIS_USER=
HIS_PASSWORD=
HIS_DATABASE=

# Assist = this app's own PostgreSQL DB (read/write, default port 5432): machines, modules, rules, check logs.
ASSIST_HOST=
ASSIST_PORT=
ASSIST_USER=
ASSIST_PASSWORD=
ASSIST_DATABASE=

# Windows agent enrollment: shared key a new agent must present on first /api/agent/register.
# After enrollment each machine gets its own API token (stored hashed in the Assist DB). Generate with `openssl rand -base64 32`.
AGENT_ENROLL_KEY=

# Auth.js session secret (encrypts the session cookie). Generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Production (`next start`) only: set to true behind a reverse proxy, or Auth.js rejects the host (UntrustedHost). Not needed in dev.
AUTH_TRUST_HOST=

# Super user login (Credentials provider). Enabled only while both are set; leave empty to turn it off once SSO is in place.
AUTH_ADMIN_USER=
AUTH_ADMIN_PASSWORD=

# SSO: PLK Health ID (OIDC). Enabled while all four are set.
# REDIRECT_URI must match one registered at the IdP exactly: http://localhost:3000/auth/callback (dev) or https://<prod-host>/auth/callback (prod)
AUTH_PLKHEALTH_REDIRECT_URI=
AUTH_PLKHEALTH_ISSUER=
AUTH_PLKHEALTH_ID=
AUTH_PLKHEALTH_SECRET=

# Dev only: comma-separated hostnames/patterns allowed to open the dev server by IP from the LAN (no scheme/port), e.g. 192.168.*.*
DEV_ALLOWED_ORIGINS=
